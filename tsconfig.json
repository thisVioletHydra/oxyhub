{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "*": ["./*"],
      "#plugin-types": ["./src/origin/plugin-types.ts"],
      "#rules/*": ["./src/origin/rules/*/index.ts"],
      "#layout/*": ["./src/origin/layout/*"],
      "#imports/*": ["./src/origin/imports/*"]
    },
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/origin", "src/painRoom", "oxlint.config.ts", "write-recommended.ts"]
}
