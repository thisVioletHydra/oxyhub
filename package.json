  },
  "peerDependencies": {
    "oxlint": "^1.79.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "eslint": "^10.9.1",
    "oxlint": "^1.81.0",
    "tsdown": "^0.16.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0"
}
