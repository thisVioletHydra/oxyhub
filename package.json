{
  "name": "@oxxy/oxlint-plugin",
  "version": "0.1.0",
  "description": "Oxlint plugin: layout, Node.js imports, and boolean-condition rules",
  "type": "module",
  "license": "MIT",
  "author": "thisVioletHydra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisVioletHydra/oxxy.git"
  },
  "homepage": "https://github.com/thisVioletHydra/oxxy#readme",
  "bugs": {
    "url": "https://github.com/thisVioletHydra/oxxy/issues"
  },
  "keywords": [
    "oxlint",
    "oxc",
    "lint",
    "plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
