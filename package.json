{
  "name": "@oxyhub/oxlint-plugin",
  "version": "0.1.2",
  "description": "Oxlint plugin: layout, TypeScript conventions, and correctness rules",
  "type": "module",
  "license": "MIT",
  "author": "thisVioletHydra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisVioletHydra/oxyhub.git"
  },
  "homepage": "https://github.com/thisVioletHydra/oxyhub#readme",
  "bugs": {
    "url": "https://github.com/thisVioletHydra/oxyhub/issues"
  },
  "keywords": [
    "oxlint",
    "oxc",
    "lint",
    "plugin"
  ],
  "imports": {
    "#plugin-types": "./src/origin/plugin-types.ts",
    "#rules/*": "./src/origin/rules/*/index.ts",
    "#layout/*": "./src/origin/layout/*.ts",
    "#imports/*": "./src/origin/imports/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./recommended.json": "./dist/recommended.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node src/origin/write-recommended.ts",
    "prepublishOnly": "pnpm build",
    "lint": "pnpm build && oxlint src/origin src/painRoom",
    "lint:fix": "pnpm build && oxlint --fix src/origin src/painRoom",
    "test": "vitest run",
    "punish": "node src/painRoom/punish.ts",
    "punish:once": "node src/painRoom/punish.ts --once",
    "release": "bumpp",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "oxlint": "^1.79.0"
  },
  "devDependencies": {
    "@oxyhub/oxlint-plugin": "workspace:*",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.4.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.9.1",
    "oxlint": "^1.81.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
